# Frontend (Next.js) - copy to .env.local
# Base URL of the READ-ONLY Flask API (scraper/api.py). It serves the
# database; freshness comes from the separate scraper worker process.
FOOTBALL_API_BASE=http://127.0.0.1:9000
# Secret for the /api/cron/refresh warmer (must match API_CRON_SECRET on the
# backend; empty = open)
CRON_SECRET=

# ---- Backend: TWO processes since the api/scraper split ------------------
#   1. read-only API:  python -m scraper.cli api      (serves the frontend)
#   2. scraper worker: python -m scraper.cli worker   (keeps the DB fresh;
#      the ONLY process that talks to goal.com - scheduler + refresh_jobs)
# Both share the same database:
FOOTBALL_DB_URL=postgresql://postgres:postgres@localhost:5432/football

# ---- API server tuning ----------------------------------------------------
# Directory for the crest/image cache used by the /api/img token proxy
# IMG_CACHE_DIR=/path/to/img_cache
# IMG_MEM_CACHE_MB=128           # in-memory hot image LRU
# DB_POOL_MIN=1 / DB_POOL_MAX=8  # per-process PostgreSQL pool
# COMPETITION_TTL_SEC=1800       # staleness window for standings/rounds
# ON_DEMAND_RETRY_SEC=600        # re-request window for failed data-gap jobs
# Secret required by /api/cron/refresh (empty = open)
# API_CRON_SECRET=

# ---- Shared response cache (Redis, optional) -------------------------------
# Set REDIS_URL on BOTH the API and the worker. The API then serves every
# JSON endpoint from a cache-aside layer in front of PostgreSQL (one Redis
# GET per hit; a matching If-None-Match answers 304 with zero DB work), and
# the worker drops the affected keys the moment fresh data lands. Empty or
# unset = cache completely off (the API reads the database per request).
# REDIS_URL=redis://localhost:6379/0
# Per-endpoint TTL overrides, seconds (defaults in scraper/apicache.py):
# API_CACHE_TTL_LISTING_TODAY=15    # live-score day
# API_CACHE_TTL_LISTING_PAST=1800   # finished days (immutable scores)
# API_CACHE_TTL_LISTING_FUTURE=300  # fixture days
# API_CACHE_TTL_MATCH_LIVE=15 / API_CACHE_TTL_MATCH_DONE=3600
# API_CACHE_TTL_COMPETITION=60 / API_CACHE_TTL_TEAM=300 / API_CACHE_TTL_PLAYER=3600

# ---- Scraper worker tuning (see scraper/worker.py) ------------------------
# WORKER_POLL_SEC=4             # refresh_jobs poll cadence (the API's gap
#                               # requests are picked up within this many
#                               # seconds)
# Scheduler intervals (seconds; 0 disables a job)
# REFRESH_TODAY_SEC=60      # today's listing (live scores)
# REFRESH_AROUND_SEC=300    # yesterday + tomorrow listings
# ENRICH_LIVE_SEC=120       # details of currently live matches
# ENRICH_BACKFILL_SEC=1800  # backfill of finished matches missing details
# AR_LISTING_SEC=600 / AR_DETAIL_SEC=600   # slow Arabic name cycles
# COMP_REFRESH_SEC=1800     # fallback warm cycle for viewed leagues
# SCHEDULER_ROLE=auto       # auto | force | off (leader election when
#                           # several workers run against one database)

# ---- Docker (same image, role per container) ------------------------------
# Whole stack in one command:   docker compose up -d --build
# (postgres + redis + api + worker + frontend - see docker-compose.yml;
#  production/NPM variant: docker-compose.fkoora-full.yml)
# SERVICE_ROLE=api          # read-only API (default) | worker | all (legacy
#                           # single container: background worker + gunicorn)
# REDIS_URL=redis://fkoora-redis:6379/0   # set on BOTH api and worker

# ---- One-time historical bootstrap (worker role / Docker entrypoint) ------
# Run `python -m scraper.cli bootstrap` in the background on container start
# (parallel with the API). Slow + resumable: an interrupted walk picks up
# where it left off on the next start because the `scrape_runs` table
# records every successful date.
# BOOTSTRAP_ON_START=1              # 1 = run on start, 0 = skip (default 0)
# BOOTSTRAP_YEARS_BACK=10           # years back to walk (default 10)
# BOOTSTRAP_DAYS_AHEAD=365          # days forward to walk (default 365)
# BOOTSTRAP_NO_DETAILS=0            # 1 = listings only (no enrichment, default 0)
# BOOTSTRAP_NO_SLOW=0               # 1 = use normal 1s rate-limit (NOT recommended, default 0)
# BOOTSTRAP_ALL=0                   # 1 = enrich ALL competitions (default 0 = majors only)
# BOOTSTRAP_FORCE=0                 # 1 = re-run even if marker file exists (default 0)
# BOOTSTRAP_LOG=/app/bootstrap.log
# BOOTSTRAP_MARKER_PATH=/app/.bootstrap_complete
# GUNICORN_BIND=0.0.0.0:9000
# GUNICORN_WORKERS=1
# GUNICORN_THREADS=8
# GUNICORN_TIMEOUT=180

# Public site URL (no trailing slash) - canonical URLs, sitemap, robots.txt,
# Open Graph + JSON-LD.
#   * NEXT_PUBLIC_SITE_URL is inlined at BUILD time - rebuild after changing
#     it (the standalone server.js does not re-read .env at runtime).
#   * SITE_URL is a RUNTIME override read by the server on every request:
#       SITE_URL=https://fkoora.site node .next/standalone/server.js
#   * If both are unset the app falls back to https://fkoora.site (hardcoded),
#     so localhost can never leak into production metadata.
NEXT_PUBLIC_SITE_URL=https://fkoora.site
# SITE_URL=https://fkoora.site
