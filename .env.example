# Frontend (Next.js) - copy to .env.local
# Base URL of the Python scraper's Flask API (scraper/api.py)
FOOTBALL_API_BASE=http://127.0.0.1:8000
# Secret for the /api/cron/refresh warmer (must match API_CRON_SECRET on the
# backend; empty = open)
CRON_SECRET=

# Backend (Flask API / scraper) - export before running `python -m scraper.cli api`
# PostgreSQL connection URL (can also be passed with --db on the CLI)
FOOTBALL_DB_URL=postgresql://postgres:postgres@localhost:5432/football
# Directory for the crest/image cache used by the /api/img token proxy
# IMG_CACHE_DIR=/path/to/img_cache
# Scheduler intervals (seconds; 0 disables a job)
# REFRESH_TODAY_SEC=60      # today's listing (live scores)
# REFRESH_AROUND_SEC=300    # yesterday + tomorrow listings
# ENRICH_LIVE_SEC=120       # details of currently live matches
# ENRICH_BACKFILL_SEC=1800  # backfill of finished matches missing details
# Secret required by /api/cron/refresh (empty = open)
# API_CRON_SECRET=

# ---- One-time historical bootstrap (Docker entrypoint) -------------------
# Run `python -m scraper.cli bootstrap` in the background on container start
# (parallel with the API). Slow + resumable: an interrupted walk picks up
# where it left off on the next start because the `scrape_runs` table
# records every successful date.
# BOOTSTRAP_ON_START=1              # 1 = run on start, 0 = skip (default 0)
# BOOTSTRAP_YEARS_BACK=10           # years back to walk (default 10)
# BOOTSTRAP_DAYS_AHEAD=365          # days forward to walk (default 365)
# BOOTSTRAP_NO_DETAILS=0            # 1 = listings only (no enrichment, default 0)
# BOOTSTRAP_NO_SLOW=0               # 1 = use normal 1s rate-limit (NOT recommended, default 0)
# BOOTSTRAP_ALL=0                   # 1 = enrich ALL competitions (default 0 = majors only)
# BOOTSTRAP_FORCE=0                 # 1 = re-run even if marker file exists (default 0)
# BOOTSTRAP_LOG=/app/bootstrap.log
# BOOTSTRAP_MARKER_PATH=/app/.bootstrap_complete
# GUNICORN_BIND=0.0.0.0:9000
# GUNICORN_WORKERS=1
# GUNICORN_THREADS=8
# GUNICORN_TIMEOUT=180

# Public site URL (no trailing slash) - canonical URLs, sitemap, robots.txt,
# Open Graph + JSON-LD.
#   * NEXT_PUBLIC_SITE_URL is inlined at BUILD time - rebuild after changing
#     it (the standalone server.js does not re-read .env at runtime).
#   * SITE_URL is a RUNTIME override read by the server on every request:
#       SITE_URL=https://fkoora.site node .next/standalone/server.js
#   * If both are unset the app falls back to https://fkoora.site (hardcoded),
#     so localhost can never leak into production metadata.
NEXT_PUBLIC_SITE_URL=https://fkoora.site
# SITE_URL=https://fkoora.site
