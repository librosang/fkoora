# Football match center backend (scraper/) - ONE image, TWO roles.
#
# Build context: repository root (needs requirements.txt + scraper/).
#   docker build -t fkoora-backend -f Dockerfile.api .
#
# The api/scraper split: the API server is a pure database reader (gunicorn,
# port 9000); a separate WORKER process keeps the database fresh (scheduler
# + refresh_jobs consumer) and is the only process that talks to goal.com.
# Deploy both from this image:
#
#   docker run -d --name fkoora-api -e FOOTBALL_DB_URL=... fkoora-backend
#   docker run -d --name fkoora-worker -e SERVICE_ROLE=worker \
#                -e FOOTBALL_DB_URL=... fkoora-backend
#
# Or bring up the whole stack (postgres + redis + api + worker + frontend)
# with the shipped compose file:
#
#   docker compose up -d --build          # docker-compose.yml (standalone)
#
# Runtime configuration (environment):
#   SERVICE_ROLE             api (default) - read-only API (gunicorn :9000)
#                            worker        - scraper worker (python -m scraper.cli worker)
#                            all           - legacy single container: background
#                                            worker + gunicorn (pre-split behavior)
#   FOOTBALL_DB_URL          postgresql://user:pass@host:5432/db   (required)
#   REDIS_URL                redis://host:6379/0 - shared response cache
#                            (optional; set it on BOTH api and worker: the
#                            api caches under these keys, the worker drops
#                            them when fresh data lands). Empty = cache off.
#
#   ---- API (SERVICE_ROLE=api|all) ---------------------------------
#   API_CRON_SECRET          shared secret for /api/cron/refresh (empty = open)
#   IMG_CACHE_DIR            crest/logo disk cache (default /app/img_cache)
#   IMG_MEM_CACHE_MB         in-memory hot image LRU (default 128)
#   DB_POOL_MIN/MAX          per-process PostgreSQL pool size (default 1/8)
#   COMPETITION_TTL_SEC      staleness window for standings/rounds (default 1800)
#   API_CACHE_TTL_*          per-endpoint cache TTLs, seconds (see
#                            scraper/apicache.py: listing today/past/future,
#                            match live/done/upcoming, competition, team,
#                            player - e.g. API_CACHE_TTL_LISTING_TODAY=15)
#
#   ---- Worker (SERVICE_ROLE=worker|all) ---------------------------
#   SCHEDULER_ROLE           auto (default) | force | off (leader election)
#   WORKER_POLL_SEC          refresh_jobs poll cadence (default 4)
#   REFRESH_*/ENRICH_*/AR_*/COMP_*  scheduler intervals - see scraper/worker.py
#
#   ---- One-time historical bootstrap (worker/all roles) ----------
#   BOOTSTRAP_ON_START       1 - run `python -m scraper.cli bootstrap` in the
#                            background on container start, 0 - skip (default 0)
#   BOOTSTRAP_YEARS_BACK     years back to walk                   (default 10)
#   BOOTSTRAP_DAYS_AHEAD     days forward to walk                 (default 365)
#   BOOTSTRAP_NO_DETAILS     1 - listings only (no enrichment)    (default 0)
#   BOOTSTRAP_NO_SLOW        1 - use normal 1s rate-limit         (default 0)
#   BOOTSTRAP_ALL            1 - enrich ALL competitions          (default 0)
#   BOOTSTRAP_FORCE          1 - re-run even if marker exists     (default 0)
#   BOOTSTRAP_LOG            log file                            (default /app/bootstrap.log)
#   BOOTSTRAP_MARKER_PATH    marker file                         (default /app/.bootstrap_complete)
#
# The schema is applied idempotently on every start (CREATE TABLE IF NOT
# EXISTS inside scraper/db/schema.sql) - a fresh database needs no manual
# setup step. First data arrives with the first worker tick.
#
# When BOOTSTRAP_ON_START=1, the historical walk runs ONCE on the first start
# (worker/all role), in parallel with the API. The walk is fully resumable:
# an interrupted run resumes where it left off on the next container start
# (because the `scrape_runs` table records every successful date). On full
# completion a marker file is written so subsequent restarts are instant.

FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
  PYTHONUNBUFFERED=1 \
  PIP_NO_CACHE_DIR=1 \
  IMG_CACHE_DIR=/app/img_cache \
  BOOTSTRAP_ON_START=0 \
  BOOTSTRAP_YEARS_BACK=10 \
  BOOTSTRAP_DAYS_AHEAD=365

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Only the Python package ships in this image (schema.sql lives inside it).
COPY scraper/ ./scraper/

# Entrypoint that (optionally) launches the bootstrap in the background and
# then execs gunicorn as PID 1.
COPY docker-entrypoint.sh /app/docker-entrypoint.sh
RUN chmod +x /app/docker-entrypoint.sh

RUN mkdir -p /app/img_cache

EXPOSE 9000

ENTRYPOINT ["/app/docker-entrypoint.sh"]

# Deep healthcheck: /api/health opens a real DB connection and reports counts.
# Note: during a fresh bootstrap the DB may be empty for the first few minutes
# until the first day's listings land - the healthcheck still returns 200 OK
# as long as the API process responds.
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=5 \
  CMD python -c "import urllib.request,sys; \
  sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:9000/api/health', timeout=4).status == 200 else 1)"
